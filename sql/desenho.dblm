
Table movie {
  id integer [primary key, increment]
  name varchar(180) [not null]
  release integer [not null]
  synopsis text
  duration_minutes integer
  age_rating varchar(10)
  language varchar(50)
}

Table reviewer {
  id integer [primary key, increment]
  name varchar(180) [not null]
  password varchar(20) [not null, unique]
  email varchar(180) [not null, unique]
}

Table director {
  id integer [primary key, increment]
  name varchar(180) [not null]
}

Table movie_director {
  director_id integer [not null]
  movie_id integer [not null]

  indexes {
    (director_id, movie_id) [pk]
  }
}

Ref: movie_director.director_id > director.id
Ref: movie_director.movie_id > movie.id

Table actor {
  id integer [primary key, increment]
  name varchar(180) [not null]
}

Table movie_actor {
  actor_id integer [not null]
  movie_id integer [not null]

  indexes {
    (actor_id, movie_id) [pk]
  }
}

Ref: movie_actor.movie_id > movie.id
Ref: movie_actor.actor_id > actor.id

Table genre {
  id integer [primary key, increment]
  name varchar(180) [not null]
}

Table movie_genre {
  genre_id integer [not null]
  movie_id integer [not null]

  indexes {
    (genre_id, movie_id) [pk]
  }
}

Ref: movie_genre.movie_id > movie.id
Ref: movie_genre.genre_id > genre.id

Table review {
  id integer [primary key, increment]
  reviewer_id integer [not null]
  movie_id integer [not null]
  rating integer [note: 'CHECK: rating BETWEEN 0 AND 10']
  review text
  heart boolean
}

Ref: review.reviewer_id > reviewer.id
Ref: review.movie_id > movie.id